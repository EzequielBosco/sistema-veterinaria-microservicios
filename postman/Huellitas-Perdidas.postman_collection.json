            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Maria\",\n  \"apellido\": \"Garcia\",\n  \"telefono\": \"1199887766\",\n  \"email\": \"maria.garcia@clinica.com\",\n  \"matricula\": \"{{matricula}}\",\n  \"especialidad\": \"Cirugia\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{gateway}}/api/veterinarios/{{veterinarioId}}", "host": ["{{gateway}}"], "path": ["api", "veterinarios", "{{veterinarioId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Turnos (ms-turno)",
      "description": "Turno es la entidad central: al crearlo o editarlo, ms-turno valida contra ms-mascota y ms-veterinario (OpenFeign, con Retry y Circuit Breaker) que la mascota y cada veterinario existan.",
      "item": [
        {
          "name": "Crear turno",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// Fecha futura al azar (el turno debe ser posterior a hoy)",
                "const d = new Date();",
                "d.setDate(d.getDate() + 30 + Math.floor(Math.random() * 300));",
                "pm.collectionVariables.set(\"fechaTurno\", d.toISOString().slice(0, 10));"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                "pm.test(\"Nace PENDIENTE\", () => pm.expect(pm.response.json().estado).to.eql(\"PENDIENTE\"));",
                "pm.collectionVariables.set(\"turnoId\", pm.response.json().id);"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fecha\": \"{{fechaTurno}}\",\n  \"hora\": \"10:00\",\n  \"motivo\": \"Control anual\",\n  \"duracionMinutos\": 30,\n  \"mascotaId\": {{mascotaId}},\n  \"veterinarios\": [\n    { \"veterinarioId\": {{veterinarioId}}, \"rol\": \"PRINCIPAL\" }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{gateway}}/api/turnos", "host": ["{{gateway}}"], "path": ["api", "turnos"] }
          }
        },
        {
          "name": "Listar turnos",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{gateway}}/api/turnos", "host": ["{{gateway}}"], "path": ["api", "turnos"] } }
        },
        {
          "name": "Agenda de un veterinario en una fecha",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
            "pm.test(\"Tiene el turno creado\", () => pm.expect(pm.response.json()).to.have.lengthOf(1));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{gateway}}/api/turnos?veterinarioId={{veterinarioId}}&fecha={{fechaTurno}}", "host": ["{{gateway}}"], "path": ["api", "turnos"], "query": [{ "key": "veterinarioId", "value": "{{veterinarioId}}" }, { "key": "fecha", "value": "{{fechaTurno}}" }] } }
        },
        {
          "name": "Buscar turno por ID",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
            "pm.test(\"Trae los veterinarios con su rol\", () => pm.expect(pm.response.json().veterinarios[0].rol).to.eql(\"PRINCIPAL\"));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{gateway}}/api/turnos/{{turnoId}}", "host": ["{{gateway}}"], "path": ["api", "turnos", "{{turnoId}}"] } }
        },
        {
          "name": "Veterinarios de un turno",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{gateway}}/api/turnos/{{turnoId}}/veterinarios", "host": ["{{gateway}}"], "path": ["api", "turnos", "{{turnoId}}", "veterinarios"] } }
        },
        {
          "name": "Turnos de un veterinario",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{gateway}}/api/turnos/veterinario/{{veterinarioId}}", "host": ["{{gateway}}"], "path": ["api", "turnos", "veterinario", "{{veterinarioId}}"] } }
        },
        {
          "name": "Turnos de una mascota",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{gateway}}/api/turnos/mascota/{{mascotaId}}", "host": ["{{gateway}}"], "path": ["api", "turnos", "mascota", "{{mascotaId}}"] } }
        },
        {
          "name": "Actualizar turno",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
            "pm.test(\"Nueva hora\", () => pm.expect(pm.response.json().hora).to.match(/^11:00/));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fecha\": \"{{fechaTurno}}\",\n  \"hora\": \"11:00\",\n  \"motivo\": \"Control anual y vacunas\",\n  \"duracionMinutos\": 45,\n  \"mascotaId\": {{mascotaId}},\n  \"veterinarios\": [\n    { \"veterinarioId\": {{veterinarioId}}, \"rol\": \"PRINCIPAL\" }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{gateway}}/api/turnos/{{turnoId}}", "host": ["{{gateway}}"], "path": ["api", "turnos", "{{turnoId}}"] }
          }
        },
        {
          "name": "Cancelar turno",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
            "pm.test(\"Queda CANCELADO\", () => pm.expect(pm.response.json().estado).to.eql(\"CANCELADO\"));"
          ] } }],
          "request": { "method": "PATCH", "header": [], "url": { "raw": "{{gateway}}/api/turnos/{{turnoId}}/cancelar", "host": ["{{gateway}}"], "path": ["api", "turnos", "{{turnoId}}", "cancelar"] } }
        }
      ]
    },
    {
      "name": "5. Errores de negocio",
      "description": "Casos que la API debe rechazar. Todos devuelven un ErrorResponse con el campo `mensaje`.",
      "item": [
        {
          "name": "Dueño con DNI duplicado → 409",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));",
            "pm.test(\"Trae mensaje\", () => pm.expect(pm.response.json().mensaje).to.be.a(\"string\"));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Otro\",\n  \"apellido\": \"Duenio\",\n  \"cedula\": \"{{cedula}}\",\n  \"telefono\": \"1122334455\",\n  \"email\": null\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{gateway}}/api/duenios", "host": ["{{gateway}}"], "path": ["api", "duenios"] }
          }
        },
        {
          "name": "Dueño inexistente → 404",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{gateway}}/api/duenios/999999999", "host": ["{{gateway}}"], "path": ["api", "duenios", "999999999"] } }
        },
        {
          "name": "Mascota con dueño inexistente → 404 (validación Feign)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));",
            "pm.test(\"Lo informa ms-mascota tras consultar ms-duenio\", () => pm.expect(pm.response.json().mensaje).to.include(\"duenio\"));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
