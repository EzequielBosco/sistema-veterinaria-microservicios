            "pm.collectionVariables.set(\"mascotaId\", pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Firulais\",\n  \"especie\": \"Perro\",\n  \"raza\": \"Labrador\",\n  \"color\": \"Dorado\",\n  \"sexo\": \"MACHO\",\n  \"fechaNacimiento\": \"2020-03-10\",\n  \"duenioId\": {{duenioId}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{gateway}}/api/mascotas", "host": ["{{gateway}}"], "path": ["api", "mascotas"] }
          }
        },
        {
          "name": "Listar mascotas",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{gateway}}/api/mascotas", "host": ["{{gateway}}"], "path": ["api", "mascotas"] } }
        },
        {
          "name": "Buscar mascota por ID",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
            "pm.test(\"Referencia al dueño por ID\", () => pm.expect(pm.response.json().duenioId).to.eql(Number(pm.collectionVariables.get(\"duenioId\"))));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{gateway}}/api/mascotas/{{mascotaId}}", "host": ["{{gateway}}"], "path": ["api", "mascotas", "{{mascotaId}}"] } }
        },
        {
          "name": "Mascotas de un dueño",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
            "pm.test(\"Tiene 1 mascota\", () => pm.expect(pm.response.json()).to.have.lengthOf(1));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{gateway}}/api/mascotas/duenio/{{duenioId}}", "host": ["{{gateway}}"], "path": ["api", "mascotas", "duenio", "{{duenioId}}"] } }
        },
        {
          "name": "Actualizar mascota",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Firulais\",\n  \"especie\": \"Perro\",\n  \"raza\": \"Labrador\",\n  \"color\": \"Negro\",\n  \"sexo\": \"MACHO\",\n  \"fechaNacimiento\": \"2020-03-10\",\n  \"duenioId\": {{duenioId}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{gateway}}/api/mascotas/{{mascotaId}}", "host": ["{{gateway}}"], "path": ["api", "mascotas", "{{mascotaId}}"] }
          }
        }
      ]
    },
    {
