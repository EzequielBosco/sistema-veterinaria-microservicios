            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Maria\",\n  \"apellido\": \"Garcia\",\n  \"telefono\": \"1199887766\",\n  \"email\": null,\n  \"matricula\": \"{{matricula}}\",\n  \"especialidad\": \"Cirugia\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{gateway}}/api/veterinarios", "host": ["{{gateway}}"], "path": ["api", "veterinarios"] }
          }
        },
